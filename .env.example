# Swiss Job Agent settings. ./install.sh creates .env from this file; never commit .env.
# The Settings page in the app overrides the search values below (stored in data/settings.json).

# --- web interface ---
# Port and address the web interface listens on. 127.0.0.1 = this machine only (safe default);
# 0.0.0.0 = every interface, only behind an authenticating proxy (see "Access control" below).
PORT=8080
BIND_ADDR=127.0.0.1
# 1 = setup wizard (import your CV / LinkedIn) until data/profile.json exists
ONBOARDING=1
# Prebuilt image only (docker-compose.image.yml / ./jobagent): pin a version, e.g. :1.2
#IMAGE=ghcr.io/nigifabio/swiss-job-agent:latest

# --- providers (which sources run, in order, ";"-separated) ---
#   ats       company job boards in the watchlist (Greenhouse, Lever, Ashby, SmartRecruiters,
#             Workday, Personio, Recruitee, Teamtailor, Workable) - fill with: python -m app.discover
#   jobup     jobs.ch + jobup.ch            jobroom   Job-Room (work.swiss, SECO)
#   remote    Remotive, Remote OK, Himalayas (remote roles open to CH/Europe/worldwide)
#   adzuna / careerjet / jooble   aggregators, silent until their key is set
#   email     job-alert emails (LinkedIn, Indeed, jobs.ch...) from a dedicated mailbox, silent until IMAP_HOST
PROVIDERS=jobup;jobroom;ats;remote

# --- ATS crawler (no API key needed) ---
# Watchlist is auto-built by: docker compose run --rm scheduler python -m app.discover
# Keep only postings in these languages (langdetect codes):
LANGUAGES=en,fr
# Keep only titles containing one of these whole words; blank = keep all:
# a trailing * matches a prefix (coordinat* = coordinator, coordinatrice...)
TITLE_KEYWORDS=
# Drop titles containing any of these:
TITLE_EXCLUDE=junior,intern,internship,trainee,stagiaire
# Location words to keep (default: all of Switzerland); remote only if CH/EU/EMEA-scoped:
#LOCATION_KEYWORDS=geneva,genève,lausanne,vaud,nyon
ALLOW_REMOTE=1
# CV skills (comma-separated) -> 0-100 relevance score, dashboard sorts by it:
SCORE_KEYWORDS=

# --- Adzuna (optional aggregator; add 'adzuna' to PROVIDERS to enable) ---
# Get keys at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=ch

# --- Search config ---
# Semicolon-separated search terms:
SEARCH_TERMS=Project Manager;Business Analyst
# One or more regions, ";"-separated
WHERE=Vaud
RESULTS_PER_PAGE=50

# --- Scheduler ---
FETCH_INTERVAL_HOURS=12

# --- jobs.ch / jobup.ch (gray area: unofficial API, against ToS) ---
# Add 'jobup' to PROVIDERS to enable.
#JOBCLOUD_SITES=jobs.ch,jobup.ch
#JOBCLOUD_PAGES=2

# --- Storage ---
DB_PATH=/data/jobs.db

# --- Access control (recommended) ---
# Verify the Cloudflare Access JWT on every request (the LAN port is then useless without it).
CF_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Optional extra allowlist on the JWT email, comma-separated:
ALLOWED_EMAILS=

# --- Job-Room ---
#JOBROOM_CANTONS=VD,GE        # default: from WHERE
#JOBROOM_DAYS=30

# --- Aggregators (free keys; set with deploy/set-env.sh) ---
#CAREERJET_API_KEY=
#CAREERJET_LOCALE=fr_CH
#JOOBLE_API_KEY=

# --- Job-alert emails (dedicated mailbox, opened read-only) ---
#IMAP_HOST=imap.gmail.com
#IMAP_USER=
#IMAP_PASSWORD=               # an app password, via deploy/set-env.sh
#IMAP_FOLDER=INBOX
#IMAP_DAYS=14

# --- ORP / RAV report ---
# Applications per month your ORP/RAV office asked for (Stats page and report):
#ORP_MONTHLY_TARGET=10
