# Swiss Job Agent platform settings (platform/.env; install.sh creates it with fresh secrets).
# Never commit the real file.

# --- sign-in: one Cloudflare Access application covering the platform hostname ---
CF_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=
# Emails that see /_platform/admin (comma-separated)
ADMIN_EMAILS=
# Public home page (/welcome): where "Source code" points, and an optional address to ask for an invite
#PROJECT_URL=https://github.com/nigifabio/swiss-job-agent
#CONTACT_EMAIL=
# Public address, used to print invite links
PUBLIC_URL=https://jobs.example.com

# --- secrets (generated by install.sh) ---
PLATFORM_SECRET=
PROVISIONER_TOKEN=

# --- tenants ---
TENANT_IMAGE=swiss-job-agent:latest
MAX_TENANTS=25
TENANT_WEB_MEMORY=512m
TENANT_SCHED_MEMORY=512m
TENANT_CPUS=0.5
# each tenant network gets a /28 from this pool; LAN egress from it is blocked (egress.sh)
TENANT_SUBNET_POOL=172.31.0.0/16
ARCHIVE_DAYS=30

# --- job-board keys shared by every tenant (optional; see docs/sources.md) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
CAREERJET_API_KEY=
JOOBLE_API_KEY=
