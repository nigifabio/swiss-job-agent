#!/usr/bin/env bash
# jobagent: day-to-day Docker wrapper for Swiss Job Agent.
#
# Works in two kinds of folders:
#   - a git clone (Dockerfile present): builds the image from the source, like ./install.sh
#   - an empty folder with only this script: uses the prebuilt image from ghcr.io
#
#   ./jobagent init               image mode: download the compose file and create .env
#   ./jobagent up | down | restart
#   ./jobagent status             containers, image and health
#   ./jobagent logs [-f]          web + scheduler logs
#   ./jobagent scan               run a scan now (same as "Scan now" in the app)
#   ./jobagent rescore            recompute match scores after changing SCORE_KEYWORDS
#   ./jobagent discover <seeds>   find company career sites (seed file in the image, e.g.
#                                 app/companies.romandie.txt, or a file in this folder)
#   ./jobagent verify-boards      re-check the watchlist, drop boards of other companies
#   ./jobagent update             new version (image: pull; clone: ./install.sh upgrade)
#   ./jobagent backup             database + files into backups/
#   ./jobagent shell              shell in the web container
set -euo pipefail
umask 022
cd "$(dirname "$0")"

RAW="${JOBAGENT_RAW:-https://raw.githubusercontent.com/nigifabio/swiss-job-agent/main}"
say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
die() { printf '\033[31mError:\033[0m %s\n' "$*" >&2; exit 1; }
envget() { sed -n "s/^$1=//p" .env 2>/dev/null | tail -1; }
port() { local p; p=$(envget PORT); echo "${p:-8080}"; }

if [ -f Dockerfile ] && [ -f docker-compose.yml ]; then MODE=source; COMPOSE=(docker compose)
else MODE=image; COMPOSE=(docker compose -f docker-compose.image.yml); fi
dc() { "${COMPOSE[@]}" "$@"; }

healthy() {
  for _ in $(seq 1 60); do curl -fs -o /dev/null "http://127.0.0.1:$(port)/healthz" && return 0; sleep 2; done
  return 1
}
need() {
  command -v docker >/dev/null || die "Docker is not installed: https://docs.docker.com/engine/install/"
  docker compose version >/dev/null 2>&1 || die "The Docker compose plugin is missing."
  [ -f .env ] || die "No .env here. Run: ./jobagent init  (or ./install.sh in a clone)"
  [ "$MODE" = source ] || [ -f docker-compose.image.yml ] || die "docker-compose.image.yml missing: run ./jobagent init"
}
data_dir() {
  mkdir -p data
  if [ "$(uname)" = Linux ] && [ "$(stat -c %u data)" != 1000 ]; then   # the app runs as uid 1000
    if [ "$(id -u)" = 0 ]; then chown -R 1000:1000 data
    else say "data/ must be writable by uid 1000 (the app user): sudo chown -R 1000:1000 data"; fi
  fi
}
setenv() {
  local tmp; tmp=$(mktemp)
  awk -v k="$1" -v v="$2" 'BEGIN{d=0} ($0 ~ "^#?" k "=" && !d){print k "=" v; d=1; next} {print} END{if(!d) print k "=" v}' .env > "$tmp"
  cat "$tmp" > .env && rm -f "$tmp"
}

init() {
  [ "$MODE" = image ] || die "This is a source checkout: use ./install.sh"
  command -v curl >/dev/null || die "curl is not installed."
  [ -f docker-compose.image.yml ] || { say "Downloading docker-compose.image.yml"; curl -fsSLO "$RAW/docker-compose.image.yml"; }
  if [ -f .env ]; then say "Keeping your existing .env"; return; fi
  curl -fsSL "$RAW/.env.example" -o .env
  chmod 600 .env
  local p b
  until read -rp "Port for the web interface [8080]: " p; p=${p:-8080}; [[ "$p" =~ ^[0-9]{2,5}$ ]] && [ "$p" -le 65535 ]; do
    echo "A number between 10 and 65535, please."; done
  until read -rp "Address to listen on: 127.0.0.1 (this machine only) or 0.0.0.0 [127.0.0.1]: " b; b=${b:-127.0.0.1}
        [[ "$b" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; do echo "An IPv4 address such as 127.0.0.1, please."; done
  setenv PORT "$p"; setenv BIND_ADDR "$b"
  say "Created .env (the setup wizard will build your search from your CV). Start with: ./jobagent up"
}

up() {
  need; data_dir
  if [ "$MODE" = source ]; then dc up -d --build --remove-orphans; else dc pull -q --ignore-pull-failures; dc up -d --remove-orphans; fi
  healthy || die "Not healthy. Logs: ./jobagent logs"
  say "Running: http://127.0.0.1:$(port)"
}

update() {
  need
  if [ "$MODE" = source ]; then exec ./install.sh upgrade; fi
  backup
  local before; before=$(dc images -q web 2>/dev/null | head -1)
  dc pull -q </dev/null || die "Couldn't pull the image (network, or the IMAGE tag in .env doesn't exist). Nothing changed."
  dc up -d --remove-orphans
  if healthy; then
    docker image prune -f >/dev/null
    say "Updated $(dc images web --format '{{.Repository}}:{{.Tag}} {{.ID}}' 2>/dev/null | head -1)"
  else
    [ -n "$before" ] || die "New image unhealthy and no previous image to go back to. Logs: ./jobagent logs"
    say "New image unhealthy; going back to the previous one"
    IMAGE=$before dc up -d --remove-orphans
    healthy && die "Back on the previous image ($before). Pin it with IMAGE=$before in .env until a fixed release."
    die "Previous image unhealthy too. Logs: ./jobagent logs"
  fi
}

backup() {
  [ -d data ] || { say "No data yet, nothing to back up"; return; }
  if [ "$MODE" = source ]; then ./install.sh backup; return; fi
  mkdir -p backups
  local out="backups/$(date +%Y%m%d-%H%M%S).tar.gz" skip=()
  if [ -f data/jobs.db ] && dc exec -T web python -c "import sqlite3; s=sqlite3.connect('/data/jobs.db'); d=sqlite3.connect('/data/jobs.backup.db'); s.backup(d); d.close()" </dev/null 2>/dev/null; then
    skip=(--exclude=data/jobs.db)
  fi
  tar -czf "$out" "${skip[@]+"${skip[@]}"}" --exclude='data/*.lock' data
  rm -f data/jobs.backup.db
  chmod 600 "$out"
  say "Backup: $out"
}

discover() {
  need
  [ $# -gt 0 ] || die "usage: ./jobagent discover <seed file>  (e.g. app/companies.romandie.txt)"
  local args=() mounts=() f
  for f in "$@"; do
    if [ -f "$f" ] && [ "${f#app/}" = "$f" ]; then       # a file in this folder: mount it read-only
      mounts+=(-v "$(cd "$(dirname "$f")" && pwd)/$(basename "$f"):/tmp/seeds/$(basename "$f"):ro")
      args+=("/tmp/seeds/$(basename "$f")")
    else args+=("$f"); fi
  done
  dc run --rm -T "${mounts[@]+"${mounts[@]}"}" scheduler python -m app.discover "${args[@]}" </dev/null
}

cmd=${1:-help}; [ $# -gt 0 ] && shift
case $cmd in
  init) init ;;
  up|start) up ;;
  down|stop) need; dc down ;;
  restart) need; dc restart; healthy && say "Restarted" ;;
  status) need; dc ps </dev/null; curl -fs -o /dev/null "http://127.0.0.1:$(port)/healthz" && echo "health: ok" || echo "health: NOT responding" ;;
  logs) need; dc logs --tail 200 "$@" </dev/null ;;
  scan) need; dc exec -T scheduler python -m app.fetch </dev/null ;;
  rescore) need; dc exec -T scheduler python -m app.fetch --rescore </dev/null ;;
  discover) discover "$@" ;;
  verify-boards) need; dc run --rm -T scheduler python -m app.discover --verify </dev/null ;;
  update|upgrade) update ;;
  backup) backup ;;
  shell) need; dc exec web sh ;;
  help|-h|--help) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $cmd (./jobagent help)" ;;
esac
